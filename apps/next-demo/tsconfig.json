{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Resolve @spaces/layout to its built types, not its source.
    "customConditions": [],
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
